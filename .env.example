# THE DIGIFORT LABS - Environment Configuration Template
# Copy this file to .env and fill in the values

# --- GENERAL ---
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- SECURITY ---
# IMPORTANT: Generate a strong random key for production
# You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
CSRF_SECRET_KEY=

# --- DATABASE ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digifortlabs

# --- EMAIL / SMTP ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

# --- AWS (Storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=digifort-labs-files

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
PLATFORM_AI_ENABLED=false

# --- EXTERNAL BINARIES (Optional) ---
# TESSERACT_CMD=
# POPPLER_PATH=
